<mvc:View
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:form="sap.ui.layout.form"
  controllerName="sap.fiori.poc.controller.CustomerDetail"
  displayBlock="true">
  <Page
    id="customerPage"
    title="Customer Details">
    <core:Fragment type="XML" fragmentName="sap.fiori.poc.view.NavBar"/>
    <ObjectHeader
      id="customerHeader"
      title="{customers>name}"
      intro="{customers>industry} · {customers>city}, {customers>country}"
      icon="sap-icon://customer">
      <attributes>
        <ObjectAttribute title="Industry" text="{customers>industry}"/>
        <ObjectAttribute title="Location" text="{customers>city}, {customers>country}"/>
        <ObjectAttribute title="Customer since" text="{customers>since}"/>
        <ObjectAttribute title="Credit rating" text="{customers>creditRating}"/>
      </attributes>
    </ObjectHeader>
    <Panel headerText="Contact &amp; Company Details" expandable="false" class="sapUiSmallMargin">
      <form:SimpleForm
        id="customerDetailsForm"
        editable="false"
        layout="ResponsiveGridLayout"
        labelSpanXL="3" labelSpanL="3" labelSpanM="3" labelSpanS="12"
        columnsXL="2" columnsL="2" columnsM="1"
        class="sapUiResponsiveMargin">
        <form:content>
          <core:Title text="Contact"/>
          <Label text="Name"/>
          <Text text="{customers>contact}"/>
          <Label text="Title"/>
          <Text text="{customers>contactTitle}"/>
          <Label text="Phone"/>
          <Link text="{customers>phone}" href="tel:{customers>phone}"/>
          <Label text="Email"/>
          <Link text="{customers>email}" href="mailto:{customers>email}"/>
          <core:Title text="Company"/>
          <Label text="Industry"/>
          <Text text="{customers>industry}"/>
          <Label text="Location"/>
          <Text text="{customers>city}, {customers>country}"/>
          <Label text="Customer since"/>
          <Text text="{customers>since}"/>
          <Label text="Credit rating"/>
          <Text text="{customers>creditRating}"/>
        </form:content>
      </form:SimpleForm>
    </Panel>
    <Toolbar>
      <Title level="H4" text="Orders in 2026"/>
      <Text text="({kpi>orderCount} orders, total {kpi>totalValue})" class="sapUiSmallMarginBegin"/>
      <ToolbarSpacer/>
      <Button text="Back" type="Ghost" icon="sap-icon://nav-back" press="onBack"/>
    </Toolbar>
    <Table
      id="customerOrdersTable"
      inset="false"
      items="{path: 'orders>/'}">
      <columns>
        <Column id="colOrderId">
          <Text text="Order ID"/>
        </Column>
        <Column id="colAmount">
          <Text text="Amount"/>
        </Column>
        <Column id="colStatus">
          <Text text="Status"/>
        </Column>
        <Column id="colBuilt">
          <Text text="Built"/>
        </Column>
      </columns>
      <items>
        <ColumnListItem>
          <cells>
            <Text text="{orders>id}"/>
            <Text text="{orders>amount}"/>
            <ObjectStatus
              text="{orders>status}"
              state="{parts: ['orders>status'], formatter: '.formatStatus'}"/>
            <Text text="{orders>built}"/>
          </cells>
        </ColumnListItem>
      </items>
    </Table>
  </Page>
</mvc:View>
