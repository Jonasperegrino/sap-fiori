<mvc:View
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  controllerName="sap.fiori.poc.controller.OrderHistory"
  displayBlock="true">
  <Page
    id="ordersPage"
    title="Order History">
    <ObjectHeader
      id="ordersHeader"
      title="Orders placed in 2026"
      intro="Current year only — including orders placed from the catalog"/>
    <core:Fragment type="XML" fragmentName="sap.fiori.poc.view.NavBar"/>
    <Table
      id="ordersTable"
      inset="false"
      items="{path: 'orders>/'}">
      <columns>
        <Column id="colOrderId">
          <Text text="Order ID"/>
        </Column>
        <Column id="colCustomer">
          <Text text="Customer"/>
        </Column>
        <Column id="colAmount">
          <Text text="Amount"/>
        </Column>
        <Column id="colStatus">
          <Text text="Status"/>
        </Column>
        <Column id="colBuilt">
          <Text text="Built"/>
        </Column>
      </columns>
      <items>
        <ColumnListItem press="onRowPress">
          <cells>
            <Text text="{orders>id}"/>
            <Text text="{orders>customer}"/>
            <Text text="{orders>amount}"/>
            <ObjectStatus
              text="{orders>status}"
              state="{parts: ['orders>status'], formatter: '.formatStatus'}"/>
            <Text text="{orders>built}"/>
          </cells>
        </ColumnListItem>
      </items>
    </Table>
  </Page>
</mvc:View>
